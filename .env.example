"""Environment variables configuration template."""

# Database Configuration
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_NAME=vendor_analytics
DB_USER=sa
DB_PASSWORD=YourPassword123!
DB_TIMEOUT=30

# Application Configuration
APP_ENV=development
